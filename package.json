{
  "name": "oleksiisedun.com",
  "version": "1.0.0",
  "description": "Personal terminal-style portfolio",
  "scripts": {
    "dev": "serve src",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/css/**/*.css\"",
    "typecheck": "tsc -p .",
    "format": "prettier --write \"**/*.{js,mjs,json}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json}\"",
    "check:sw": "node scripts/check-sw.mjs",
    "check": "npm run lint && npm run lint:css && npm run typecheck && npm run format:check && npm run check:sw && npm run test",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "serve": "^14.2.4",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended": "^18.0.0",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
